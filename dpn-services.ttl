@prefix cc: <http://creativecommons.org/ns#> .
@prefix dc: <http://purl.org/dc/terms/> .
@prefix dpn: <http://purl.org/dpn#> .
@prefix dpnd: <http://purl.org/dpn/dataset#> .
@prefix dpns: <http://purl.org/dpn/services#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xml: <http://www.w3.org/XML/1998/namespace> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix sdo: <https://schema.org/> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix vann: <http://purl.org/vocab/vann/> .

<http://purl.org/dpn/services>
  rdf:type owl:Ontology ;
  rdf:type cc:Work ;
  cc:license "<http://creativecommons.org/licenses/by/4.0/>" ;
  dc:contributor [
    sdo:affiliation [
      sdo:identifier <https://ror.org/03qn8fb07> ;
      sdo:name "CSIRO" ;
      sdo:url <https://www.csiro.au/> ;
    ] ;
    sdo:identifier <https://orcid.org/0000-0002-3884-3420> ;
    sdo:name "Simon Cox" ;
  ] ;
  dc:contributor [
    sdo:affiliation [
      sdo:identifier <https://ror.org/03qn8fb07> ;
      sdo:name "CSIRO" ;
      sdo:url <https://www.csiro.au/> ;
    ] ;
    sdo:identifier <https://orcid.org/0000-0003-1223-9935> ;
    sdo:name "Sharon Tickell" ;
  	sdo:url <https://people.csiro.au/t/s/sharon-tickell> ;
  ] ;
  dc:creator [
    sdo:affiliation [
      sdo:identifier <https://ror.org/03qn8fb07> ;
      sdo:name "CSIRO" ;
      sdo:url <https://www.csiro.au/> ;
    ] ;
    sdo:name "Jonathan Yu" ;
    sdo:identifier <https://orcid.org/0000-0002-2237-0091> ;
    sdo:url <https://people.csiro.au/y/j/jonathan-yu> ;
  ] ;
  dc:description """This ontology is being developed by CSIRO under the eReefs project for describing
  data, metadata and catalog service variants. It extends the base ontology with a vocabulary of
  base-class descriptions representing generalisations of some common service types.""" ;
  dc:publisher [
    sdo:affiliation [
      sdo:identifier <https://ror.org/03qn8fb07> ;
      sdo:name "CSIRO" ;
      sdo:url <https://www.csiro.au/> ;
    ] ;
    sdo:name "eReefs" ;
    sdo:url <https://www.ereefs.org.au/> ;
  ] ;
  dc:source <https://github.com/eReefs/dpn-ontology/> ;
  dc:title "Data Provider Node Services ontology" ;
  owl:imports <http://purl.org/dpn/v0.9> ;
  owl:priorVersion <http://purl.org/dpn/services/v0.8> ;
  owl:versionIRI <http://purl.org/dpn/services/v0.9> ;
  owl:versionInfo "v0.9 eReefs Phase 6a 2025" ;
  skos:changeNote "Addition of more service and catalog types" ;
  vann:preferredNamespacePrefix "dpns" ;
  vann:preferredNamespaceUri <http://purl.org/dpn/services#> ;
.

#..............................................................................
# region Standard Interfaces

dpns:CSW
  rdf:type owl:Class ;
  dc:source <https://www.ogc.org/standards/cat/> ;
  rdfs:comment "A profile of the Open Geopatial Consortium (OGC) Catalog Service standard for exposing a catalogue of geospatial records in XML format via HTTP." ;
  rdfs:comment "See also: <https://en.wikipedia.org/wiki/Catalogue_Service_for_the_Web>" ;
  rdfs:label "Catalogue Service for the Web (CSW)" ;
  skos:altLabel "CSW";
  rdfs:subClassOf dpn:MetadataServiceInterface ;
  rdfs:subClassOf dpn:CatalogServiceInterface ;
.
dpns:DublinCore
  rdf:type owl:Class ;
  dc:source <http://purl.org/dc/terms> ;
  rdfs:comment """A general-purpose metadata vocabulary for describing resources of any type.""" ;
  rdfs:comment "See also: <https://en.wikipedia.org/wiki/Dublin_Core>" ;
  rdfs:label "Dublin Core Metadata Terms (DCMT)" ;
  skos:altLabel "DMCT";
  rdfs:subClassOf dpn:MetadataServiceInterface ;
.
dpns:HTTP
  rdf:type owl:Class ;
  rdfs:comment "In a DPN context, a HTTP Data Service Interface makes the data available for download over HTTP, rather than implementing a documented query interface." ;
  rdfs:label "HyperText Transfer Protocol (HTTP)" ;
  skos:altLabel "HTTP";
  rdfs:subClassOf dpn:DataServiceInterface ;
.
dpns:ISO
  rdf:type owl:Class ;
  dc:source <https://standards.iso.org/iso/19115/> ;
  dc:source <https://standards.iso.org/iso/19139/> ;
  rdfs:comment """International Metadata standard for describing GeoSpatial Information.
  The metadata standard itself is ISO-19115 (<https://standards.iso.org/iso/19115>),
  while ISO-19139 (<https://standards.iso.org/iso/19139/>) describes a schema for
  representing ISO-19115 metadata in XML format.""" ;
  rdfs:comment "See also: <https://en.wikipedia.org/wiki/Geospatial_metadata>" ;
  rdfs:label "ISO-19115 Metadata Standard" ;
  rdfs:label "ISO-19139 Metadata Implementation Schema" ;
  skos:altLabel "ISO";
  rdfs:subClassOf dpn:MetadataServiceInterface ;
.
dpns:NcWMS
  rdf:type owl:Class ;
  dc:source <https://reading-escience-centre.gitbooks.io/ncwms-user-guide/> ;
  rdfs:comment """Extension of the OGC WMS protocol for multidimensional scientific datasets.
  Supports all of the WMS Standard, and several additional endpoints: `GetTimeseries`, `GetVerticalProfile`,
  `GetTransect`, `GetMetadata` and `GetLegendGraphic`.""";
  rdfs:label "Netcdf Web Mapping Service (NcWMS)" ;
  skos:altLabel "NcWMS";
  rdfs:subClassOf dpns:WMS ;
.
dpns:NetcdfSubset
  rdf:type owl:Class ;
  dc:source <https://docs.unidata.ucar.edu/tds/current/userguide/netcdf_subset_service_ref.html> ;
  rdfs:comment """A web service for subsetting point- or grid-formatted scientific datasets in earth coordinates
  (lat.lon or projection coordinates and date ranges) rather than the index ranges of the dataset's native storage format.""" ;
  rdfs:label "Netcdf Subset Service (NCSS)" ;
  skos:altLabel "NCSS" ;
  rdfs:subClassOf dpn:DataServiceInterface ;
.
dpns:OPeNDAP
  rdf:type owl:Class ;
  dc:source <https://www.opendap.org/> ;
  rdfs:comment """OPeNDAP is a data access protocol used widely in the earth sciences.
  It defines standards for structuring data, and its annotation as well as interfaces for accessing
  data which is stored natively in HDF or NetCDF file formats. As these formats include support for
  global and parameter level attributes, an OPeNDAP service is both an observation data service
  (providing access to individual observation values) and a metadata service (providing access to
  descriptions of the dataset and parameters).""" ;
  rdfs:label "OPeNDAP Interface" ;
  rdfs:subClassOf dpn:MetadataServiceInterface ;
  rdfs:subClassOf dpn:ObservationServiceInterface ;
.
dpns:SOS
  rdf:type owl:Class ;
  dc:source <https://www.ogc.org/standards/sos/> ;
  rdfs:comment """Web service interface which allows querying sensor observations, metadata and
  representations of observed features.""" ;
  rdfs:comment "See also: <https://en.wikipedia.org/wiki/Sensor_Observation_Service>" ;
  rdfs:label "Sensor Observation Service (SOS)" ;
  skos:altLabel "SOS";
  rdfs:subClassOf dpn:ObservationServiceInterface ;
  rdfs:subClassOf dpn:MetadataServiceInterface ;
.
dpns:WCS
  rdf:type owl:Class ;
  rdfs:seeAlso <https://www.ogc.org/standards/wcs/> ;
  rdfs:comment """Open GeoSpatial Consortium (OGC) standard protocol for serving
  coverage information (spatially and temporaly-distributed data values). The
  WCS Standard includes `GetCapabilities`, `DescribeCoverage` and `GetCoverage` endpoints.""";
  rdfs:comment "See also: <https://en.wikipedia.org/wiki/Web_Coverage_Service>" ;
  rdfs:label "Web Coverage Service (WCS)" ;
  skos:altLabel "WCS";
  rdfs:subClassOf dpn:MetadataServiceInterface ;
  rdfs:subClassOf dpn:ObservationServiceInterface ;
.
dpns:WFS
  rdf:type owl:Class ;
  dc:source <https://www.ogc.org/standards/wfs/> ;
  rdfs:comment """Open GeoSpatial Consortium (OGC) standard protocol for serving
  geographical feature information encoded as Geography Markup Language (GML) over HTTP.
  Feature data is a vector format. The standard defines `GetCapabilities`, `DescribeFeatureType`
  and `GetFeature` endpoints.""" ;
  rdfs:comment "See also: <https://en.wikipedia.org/wiki/Web_Feature_Service>" ;
  rdfs:label "Web Feature Service (WFS)" ;
  skos:altLabel "WFS";
  rdfs:subClassOf dpn:DataServiceInterface ;
  rdfs:subClassOf dpn:MetdataServiceInterface ;
.
dpns:WMS
  rdf:type owl:Class ;
  dc:source <https://www.ogc.org/standards/wms> ;
  rdfs:comment """Open GeoSpatial Consortium (OGC) standard protocol for serving
  georeferenced map images over HTTP. The standard defines `GetCapabilities` and
  `GetMap` endpoints.  In addition, WMS providers may optionally support some
  additional endpoints: `GetFeatureInfo`, `DescribeLayer` and `GetLegendGraphic`.""" ;
  rdfs:comment """Each WMS layer corresponds to a single Observation DataSet
  in a Data Provider node context.""" ;
  rdfs:comment "See also: <https://en.wikipedia.org/wiki/Web_Map_Service>" ;
  rdfs:label "Web Map Service (WMS)" ;
  skos:altLabel "WMS";
  rdfs:subClassOf dpn:MetadataServiceInterface ;
  rdfs:subClassOf dpn:ObservationServiceInterface ;
.
dpns:WMTS
  rdf:type owl:Class ;
  dc:source <https://www.ogc.org/standards/wmts/> ;
  rdfs:comment """Open GeoSpatial Consortium (OGC) standard protocol for serving
  digtal maps using predefined image tiles over HTTP.""" ;
  rdfs:comment "See also: <https://en.wikipedia.org/wiki/Web_Map_Tile_Service>" ;
  rdfs:label "Web Map Tile Service (WMTS)" ;
  skos:altLabel "WMTS";
  rdfs:subClassOf dpn:DataServiceInterface ;
.
# endregion

#..............................................................................
# region ArcGIS
dpns:ImageServer
  rdf:type owl:Class ;
  dc:source <https://www.esri.com/en-us/arcgis/products/arcgis-image/options/arcgis-image-server> ;
  rdfs:comment """ESRI ArcGIS Image Server is a commercial server product which provides serving, processing, analysis,
  and extracting value from massive collections of imagery, rasters, and remotely sensed data.
  It is an extension of ESRI's ArcGIS Enterprise product, and depends on that for WMS or WCS capabilities.
  If deployed as a standalone application, it uses its own custom interface protocol.
  """;
  rdfs:comment "See also: <https://webhelp.esri.com/arcgisdesktop/9.3/index.cfm?TopicName=The_ArcGIS_Server_and_Image_Server_architecture>" ;
  rdfs:label "ArcGIS Image Server" ;
  rdfs:subClassOf dpn:Service ;
.

# endregion

#..............................................................................
# region GeoNetwork

dpns:GeoNetwork
  rdf:type owl:Class ;
  dc:source <https://geonetwork-opensource.org/> ;
  rdfs:comment """GeoNetwork is a an open source geospatial metadata catalog server.
  A geoserver instance usually hosts detailed metadata records for datasets hosted  elsewhere, but may also
  support direct downloads of small datasets. It supports DublinCore and ISO-standard metadata records and a CSW API
  interface out of the box, and may also be extended to support additional metadata profiles by use of plugins.""" ;
  rdfs:label "GeoNetwork Server" ;
  skos:altLabel "GeoNetwork";
  rdfs:subClassOf dpn:Service ;
  rdfs:subClassOf [
      rdf:type owl:Restriction ;
      owl:onProperty dpn:implements ;
      owl:someValuesFrom dpns:CSW ;
    ] ;
  rdfs:subClassOf [
      rdf:type owl:Restriction ;
      owl:onProperty dpn:implements ;
      owl:someValuesFrom dpns:DublinCore ;
    ] ;
  rdfs:subClassOf [
      rdf:type owl:Restriction ;
      owl:onProperty dpn:implements ;
      owl:someValuesFrom dpns:ISO ;
    ] ;
.
# endregion

#..............................................................................
# region GeoServer

dpns:GeoServer
  rdf:type owl:Class ;
  dc:source <https://geoserver.org/> ;
  rdfs:comment """GeoServer is an open-source web server for geospatial data. It is the reference implementation of the
  Open Geospatial Consortium (OGC) Web Feature Service (WFS) and Web Coverage Service (WCS) standards, as well as a
  high performance certified compliant Web Map Service (WMS).""" ;
  rdfs:label "GeoServer" ;
  skos:altLabel "GeoServer";
  rdfs:subClassOf dpn:Service ;
  rdfs:subClassOf [
      rdf:type owl:Restriction ;
      owl:onProperty dpn:implements ;
      owl:someValuesFrom dpns:CSW ;
    ] ;
  rdfs:subClassOf [
      rdf:type owl:Restriction ;
      owl:onProperty dpn:implements ;
      owl:someValuesFrom dpns:WCS ;
    ] ;
  rdfs:subClassOf [
      rdf:type owl:Restriction ;
      owl:onProperty dpn:implements ;
      owl:someValuesFrom dpns:WFS ;
    ] ;
  rdfs:subClassOf [
      rdf:type owl:Restriction ;
      owl:onProperty dpn:implements ;
      owl:someValuesFrom dpns:WMS ;
    ] ;
.
# endregion

#..............................................................................
# region MapServer

dpns:MapServer
  rdf:type owl:Class ;
  dc:source <https://mapserver.org/> ;
  rdfs:comment "MapServer is an open source platform for publishing spatial data and interactive mapping applications to the web. It supports WMS, WFS and WCS interfaces." ;
  rdfs:label "MapServer" ;
  skos:altLabel "MapServer";
  rdfs:subClassOf dpn:Service ;
  rdfs:subClassOf [
      rdf:type owl:Restriction ;
      owl:onProperty dpn:implements ;
      owl:someValuesFrom dpns:WCS ;
    ] ;
  rdfs:subClassOf [
      rdf:type owl:Restriction ;
      owl:onProperty dpn:implements ;
      owl:someValuesFrom dpns:WFS ;
    ] ;
  rdfs:subClassOf [
      rdf:type owl:Restriction ;
      owl:onProperty dpn:implements ;
      owl:someValuesFrom dpns:WMS ;
    ] ;
.
# endregion

#..............................................................................
# region PIDService

dpns:PIDService
  rdf:type owl:Class ;
  dc:source <https://web.archive.org/web/20210329015228/https://www.seegrid.csiro.au/wiki/Siss/PIDService> ;
  rdfs:comment "Persistent Identifier Dispatcher Service (PIDSvc) is an open-source server that allows registration and deferencing of persistent identifier handles." ;
  rdfs:label "Persistent Identifier Service" ;
  skos:altLabel "PID Service";
  rdfs:subClassOf dpn:Service ;
  rdfs:subClassOf [
      rdf:type owl:Restriction ;
      owl:onProperty dpn:implements ;
      owl:someValuesFrom dpn:IdentifierService ;
    ] ;
.
#endregion

#..............................................................................
# region PROMS
dpns:PromsServiceInterface
  rdf:type owl:Class ;
  dc:source <https://github.com/CSIRO-enviro-informatics/proms> ;
  rdfs:comment """The Provenance Management System (PROMS) service interface allows access to the PROMS implementation
  for retrieval and storage of provenance instance reports and any semantic annotations""" ;
  rdfs:comment "See also: <https://www.mssanz.org.au/modsim2015/C4/wise.pdf>" ;
  rdfs:comment "See also: <https://doi.org/10.4225/08/5571046ED9FDB>" ;
  rdfs:label "PROMS Service Interface" ;
  skos:altLabel "PROMS";
  rdfs:subClassOf dpn:ProvenanceServiceInterface ;
.
# endregion

#..............................................................................
# region SISSVoc

dpns:SISSVocServiceInterface
  rdf:type owl:Class ;
  dc:source <https://web.archive.org/web/20200418050243/https://www.seegrid.csiro.au/wiki/Siss/SISSvoc30API> ;
  rdfs:comment "SISSVoc Service Interface definition" ;
  rdfs:label "SISSVoc Service Interface" ;
  skos:altLabel "SISSVoc interface";
  rdfs:subClassOf dpn:VocabularyServiceInterface ;
.
dpns:SISSVocService
  rdf:type owl:Class ;
  dc:source <https://web.archive.org/web/20200315033011/https:/www.seegrid.csiro.au/wiki/Siss/VocabularyService> ;
  rdfs:comment """Spatial Information Services Stack Vocabulary Service (SISSVoc) was an open-source web application
  intended to support hosting of controlled vocabularies..""" ;
  rdfs:label "SISSVoc Server" ;
  skos:altLabel "SISSVoc";
  rdfs:subClassOf dpn:Service ;
  rdfs:subClassOf [
      rdf:type owl:Restriction ;
      owl:onProperty dpn:implements ;
      owl:someValuesFrom dpns:SISSVocServiceInterface ;
    ] ;
.
# endregion

#..............................................................................
# region THREDDS
dpns:THREDDS
  rdf:type owl:Class ;
  dc:source <https://www.unidata.ucar.edu/software/tds> ;
  rdfs:comment """THREDDS is a web server that provides data-query-interfaces for scientific datasets,
  using a variety of remote data access protocols, including OpenDAP, NcWMS and WCS. It may optionally expose
  raw data files for direct download via HTTP, and ISO-formatted metadata records.""" ;
  rdfs:label "THREDDS Data Server" ;
  skos:altLabel "THREDDS";
  skos:altLabel "TDS";
  rdfs:subClassOf dpn:Service ;
  rdfs:subClassOf [
      rdf:type owl:Restriction ;
      owl:onProperty dpn:implements ;
      owl:someValuesFrom dpns:HTTP ;
    ] ;
  rdfs:subClassOf [
      rdf:type owl:Restriction ;
      owl:onProperty dpn:implements ;
      owl:someValuesFrom dpns:ISO ;
    ] ;
  rdfs:subClassOf [
      rdf:type owl:Restriction ;
      owl:onProperty dpn:implements ;
      owl:someValuesFrom dpns:OPeNDAP ;
    ] ;
  rdfs:subClassOf [
      rdf:type owl:Restriction ;
      owl:onProperty dpn:implements ;
      owl:someValuesFrom dpns:WCS ;
    ] ;
  rdfs:subClassOf [
      rdf:type owl:Restriction ;
      owl:onProperty dpn:implements ;
      owl:someValuesFrom dpns:NCSS ;
    ] ;
  rdfs:subClassOf [
      rdf:type owl:Restriction ;
      owl:onProperty dpn:implements ;
      owl:someValuesFrom dpns:NcWMS ;
    ] ;
.
# endregion
