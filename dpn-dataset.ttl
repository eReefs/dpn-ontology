@prefix cc: <http://creativecommons.org/ns#> .
@prefix dc: <http://purl.org/dc/terms/> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix dpn: <http://purl.org/dpn#> .
@prefix dpnd: <http://purl.org/dpn/dataset#> .
@prefix geo: <http://www.w3.org/2003/01/geo/wgs84_pos#> .
@prefix op: <http://environment.data.gov.au/def/op#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix puv: <https://w3id.org/env/puv#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sdo: <https://schema.org/> .
@prefix sosa: <http://www.w3.org/ns/sosa/> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix time: <http://www.w3.org/2006/time#> .
@prefix vann: <http://purl.org/vocab/vann/> .
@prefix xml: <http://www.w3.org/XML/1998/namespace> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<http://purl.org/dpn/dataset>
  rdf:type owl:Ontology ;
  rdf:type cc:Work ;
  cc:license "<http://creativecommons.org/licenses/by/4.0/>" ;
  dc:contributor [
    sdo:affiliation [
      sdo:identifier <https://ror.org/03qn8fb07> ;
      sdo:name "CSIRO" ;
      sdo:url <https://www.csiro.au/> ;
    ] ;
    sdo:identifier <https://orcid.org/0000-0002-3884-3420> ;
    sdo:name "Simon Cox" ;
  ] ;
  dc:contributor [
    sdo:affiliation [
      sdo:identifier <https://ror.org/03qn8fb07> ;
      sdo:name "CSIRO" ;
      sdo:url <https://www.csiro.au/> ;
    ] ;
    sdo:identifier <https://orcid.org/0000-0003-1223-9935> ;
    sdo:name "Sharon Tickell" ;
  	sdo:url <https://people.csiro.au/t/s/sharon-tickell> ;
  ] ;
  dc:creator [
    sdo:affiliation [
      sdo:identifier <https://ror.org/03qn8fb07> ;
      sdo:name "CSIRO" ;
      sdo:url <https://www.csiro.au/> ;
    ] ;
    sdo:name "Jonathan Yu" ;
    sdo:identifier <https://orcid.org/0000-0002-2237-0091> ;
    sdo:url <https://people.csiro.au/y/j/jonathan-yu> ;
  ] ;
  dc:description "This ontology is being developed by CSIRO under the eReefs project for describing classes of datasets, such as observational datasets." ;
  dc:description "It imports the Parameter Usage Vocabulary (PUV) ontology to support dataset-parameter-level metadata." ;
  dc:publisher [
    sdo:affiliation [
      sdo:identifier <https://ror.org/03qn8fb07> ;
      sdo:name "CSIRO" ;
      sdo:url <https://www.csiro.au/> ;
    ] ;
    sdo:name "eReefs" ;
    sdo:url <https://www.ereefs.org.au/> ;
  ] ;
  dc:source <https://github.com/eReefs/dpn-ontology/> ;
  dc:title "Data Provider Node Dataset ontology" ;
  owl:imports <http://purl.org/dpn/v0.9> ;
  owl:priorVersion <http://purl.org/dpn/dataset/v0.8> ;
  owl:versionIRI <http://purl.org/dpn/dataset/v0.9> ;
  owl:versionInfo "v0.9 eReefs Phase 6a 2025" ;
  vann:preferredNamespacePrefix "dpnd" ;
  vann:preferredNamespaceUri <http://purl.org/dpn/dataset#> ;
.

#..............................................................................
# region Space

dpnd:BoundingBox
  rdf:type owl:Class ;
  rdfs:comment "A geospatial bounding box that uses the WGS84 Coordinate System." ;
  rdfs:label "Bounding box" ;
  rdfs:subClassOf geo:SpatialThing ;
.
dpnd:bbBottomRight
  rdf:type owl:ObjectProperty ;
  rdfs:comment "Bottom-right (South-East-Nadir) coordinate of a geographical bounding box" ;
  rdfs:domain dpnd:BoundingBox ;
  rdfs:label "bbBottomRight" ;
  rdfs:range geo:Point ;
.
dpnd:bbTopLeft
  rdf:type owl:ObjectProperty ;
  rdfs:comment "Top-left (North-West-Zenith) coordinate of a geographical bounding box" ;
  rdfs:domain dpnd:BoundingBox ;
  rdfs:label "bbTopLeft" ;
  rdfs:range geo:Point ;
.

dpnd:spatial
  rdf:type owl:ObjectProperty ;
  rdfs:comment "The spatial location (e.g. point or bounding box) in the WGS84 coordinate system where observations were made" ;
  rdfs:domain dpnd:Observation , dpnd:ObservationGroup ;
  rdfs:label "spatial" ;
  rdfs:range [
      a owl:Class ;
      owl:unionOf ( dpnd:BoundingBox geo:Point ) ;
  ] ;
  rdfs:subPropertyOf dc:spatial ;
.
# endregion

#..............................................................................
# region Time

dpnd:TimeInterval
  rdf:type owl:Class ;
  rdfs:label "Time interval" ;
  rdfs:subClassOf dc:PeriodOfTime ;
  rdfs:subClassOf time:Interval ;
.
dpnd:start
  rdf:type owl:DatatypeProperty ;
  rdfs:comment "The beginning of a time-range" ;
  rdfs:domain dpnd:TimeInterval ;
  rdfs:label "start" ;
  rdfs:range xsd:dateTime ;
.
dpnd:end
  rdf:type owl:DatatypeProperty ;
  rdfs:comment "The end of a time interval" ;
  rdfs:domain dpnd:TimeInterval ;
  rdfs:label "end" ;
  rdfs:range xsd:dateTime ;
.
dpnd:temporal
  rdf:type owl:ObjectProperty ;
  rdfs:comment "The time-range for which observations were made" ;
  rdfs:domain dpnd:Observation , dpnd:ObservationGroup ;
  rdfs:label "temporal" ;
  rdfs:range dpnd:TimeInterval ;
  rdfs:subPropertyOf dc:temporal ;
.

# endregion

#..............................................................................
# region Dataset

dpnd:Observation
  rdf:type owl:Class ;
  rdfs:comment "A dataset which contains information about related observations of a single property. These may be directly observed (field observations) or modelled" ;
  rdfs:comment "The scientifically-interesting attributes of the observed property should be described using the Parameter Usage Vocabulary (PUV) ontology." ;
  rdfs:comment "For backwards compatibility with previous versions of the Data Provide Node dataset ontology, the attributes *may* also (or instead) be described via the deprecated Observable Properties (OP) ontology." ;

  rdfs:label "Observation" ;
  rdfs:subClassOf dpn:Dataset ;
  rdfs:subClassOf puv:Parameter ;
  rdfs:subClassOf op:PropertyKind ;
  rdfs:subClassOf [
      rdf:type owl:Restriction ;
      owl:onProperty dpnd:relatedVariable ;
      owl:cardinality 1 ;
    ] ;
  rdfs:subClassOf [
      rdf:type owl:Restriction ;
      owl:onProperty dpnd:spatial ;
      owl:someValuesFrom geo:SpatialThing ;
    ] ;
  rdfs:subClassOf [
      rdf:type owl:Restriction ;
      owl:onProperty dpnd:spatial ;
      owl:cardinality 1 ;
    ] ;
  rdfs:subClassOf [
      rdf:type owl:Restriction ;
      owl:onProperty dpnd:temporal ;
      owl:someValuesFrom dpnd:TimeInterval ;
    ] ;
  rdfs:subClassOf [
      rdf:type owl:Restriction ;
      owl:onProperty dpnd:temporal ;
      owl:cardinality 1 ;
    ] ;
  rdfs:subClassOf [
      rdf:type owl:Restriction ;
      owl:onProperty puv:parameter ;
      owl:maxCardinality 1 ;
    ] ;
  rdfs:subClassOf [
      rdf:type owl:Restriction ;
      owl:onProperty dpn:hostedBy ;
      owl:someValuesFrom dpnd:ObservationGroup ;
    ] ;
.

dpnd:relatedVariable
  owl:equivalentProperty dc:identifier ;
  rdf:type owl:Property ;
  rdfs:comment "The unique term used to identify this Observation in its ObservationGroup when querying data from the Observation's distributions." ;
  rdfs:example "If an ObservationGroup is stored in netCDF Files, the related variable is the netCDF Parameter name containing the Observation values." ;
  rdfs:domain dpnd:Observation ;
  rdfs:label "variable" ;
 .

dpnd:ObservationGroup
  rdf:type owl:Class ;
  rdfs:comment "A Dataset made up of one or more Observations which were collected (or simulated) over the same spatial and temporal range." ;
  rdfs:label "Observation Group" ;
  rdfs:subClassOf dpn:Dataset ;
  rdfs:subClassOf [
      rdf:type owl:Restriction ;
      owl:onProperty dpn:implements ;
      owl:someValuesFrom dpn:ObservationServiceInterface ;
    ] ;
  rdfs:subClassOf [
      rdf:type owl:Restriction ;
      owl:onProperty dpnd:spatial ;
      owl:someValuesFrom geo:SpatialThing ;
    ] ;
  rdfs:subClassOf [
      rdf:type owl:Restriction ;
      owl:onProperty dpnd:spatial ;
      owl:cardinality 1 ;
    ] ;
  rdfs:subClassOf [
      rdf:type owl:Restriction ;
      owl:onProperty dpnd:temporal ;
      owl:someValuesFrom dpnd:TimeInterval ;
    ] ;
  rdfs:subClassOf [
      rdf:type owl:Restriction ;
      owl:onProperty dpnd:temporal ;
      owl:cardinality 1 ;
    ] ;
  rdfs:subClassOf [
      rdf:type owl:Restriction ;
      owl:onProperty dpn:hostsDataset ;
      owl:someValuesFrom dpnd:Observation ;
    ] ;
  rdfs:subClassOf [
      rdf:type owl:Restriction ;
      owl:onProperty dpn:hostsDataset ;
      owl:minCardinality 1 ;
    ] ;
.

# endregion

#..............................................................................
# region OP-ont Properties

dpnd:relatedFeature
  owl:equivalentProperty puv:featureOfInterest ;
  rdf:type owl:DeprecatedProperty ;
  rdfs:comment "The feature-of-interest from the relatedSubstanceOrTaxon that is being observed" ;
  rdfs:domain dpnd:Observation ;
  rdfs:label "related feature" ;
  rdfs:subPropertyOf op:featureOfInterest ;
 .
dpnd:relatedMedium
  owl:equivalentProperty puv:matrix ;
  rdf:type owl:DeprecatedProperty ;
  rdfs:comment "The medium in which the feature-of-interests is embedded" ;
  rdfs:domain dpnd:Observation ;
  rdfs:label "related medium" ;
  rdfs:subPropertyOf op:matrix ;
.
dpnd:relatedQualityKind
  rdf:type owl:DeprecatedProperty ;
  rdfs:comment "The quality of the observation" ;
  rdfs:domain dpnd:Observation ;
  rdfs:label "related quality kind" ;
  rdfs:range op:QualityKind ;
  owl:subPropertyOf op:qualityKind ;
.
dpnd:relatedQuantityKind
  owl:equivalentProperty puv:property ;
  rdf:type owl:DeprecatedProperty ;
  rdfs:comment "The property or attribute of the subject which was measured for this observation" ;
  rdfs:domain dpnd:Observation ;
  rdfs:label "related quantity kind" ;
  rdfs:Range op:QuantityKind ;
  rdfs:subPropertyOf qudt:hasQuantityKind ;
.
dpnd:relatedSubstanceOrTaxon
  rdf:type owl:DeprecatedProperty ;
  rdfs:comment "The substance of taxon which is the subject of the observation." ;
  rdfs:domain dpnd:Observation ;
  rdfs:label "related substance or taxon" ;
  rdfs:range op:SubstanceOrTaxon ;
  rdfs:subPropertyOf op:objectOfInterest ;
.
dpnd:procedure
  owl:equivalentProperty puv:method ;
  rdf:type owl:DeprecatedProperty ;
  rdfs:comment "The procedure or sensor system used to make the observation or estimate of property value" ;
  rdfs:domain dpnd:Observation ;
  rdfs:label "procedure" ;
  rdfs:subPropertyOf op:procedure ;
.
dpnd:relatedUnit
  rdf:type owl:DeprecatedProperty ;
  rdfs:comment "Unit for the value of the observation." ;
  rdfs:domain dpnd:Observation ;
  rdfs:label "unit" ;
  rdfs:range qudt:Unit ;
  rdfs:subPropertyOf qudt:unit ;
.
# endregion

#----------------------------------------------------------------------
# region PUV-ont Properties
# PUV-ont property re-definitions so that we can add dpn:Observation to the domain
# Source: https://github.com/CSIRO-enviro-informatics/PUV-ont/blob/main/rdf/puv.ttl
#----------------------------------------------------------------------
puv:matrix
  owl:equivalentProperty dpnd:relatedMedium ;
  owl:equivalentProperty op:matrix ;
  rdf:type owl:ObjectProperty ;
  rdfs:comment """The context / container / medium within which the property of an entity is observed.
  Reference to the NVS Matrix (S26) term for this matrix of this observation.""" ;
  rdfs:domain puv:Parameter , dpnd:Observation ;
  rdfs:label "matrix" ;
  rdfs:range puv:Matrix ;
  skos:note "puv:Matrix Terms => NVS S26 <https://vocab.nerc.ac.uk/collection/S26/>" ;

.
puv:matrixRelationship
  owl:equivalentProperty puv:matrixRelationship ;
  rdf:type owl:ObjectProperty ;
  rdfs:comment """Reference to the NVS Measurement-matrix relationship (S02) term for this observation.""" ;
  rdfs:domain puv:Parameter , dpnd:Observation ;
  rdfs:label "measurement-matrix relationship" ;
  rdfs:range puv:MMRel ;
  skos:note "puv:MMRel Terms => NVS S02 <https://vocab.nerc.ac.uk/collection/S02/>" ;

.
puv:method
  owl:equivalentProperty dpnd:procedure ;
  owl:equivalentProperty op:procedure ;
  owl:equivalentProperty puv:analyticalMethod ;
  owl:equivalentProperty puv:dataProcessing ;
  owl:equivalentProperty puv:sampleProcessing ;
  owl:equivalentProperty qudt:generalization ;
  rdf:type owl:ObjectProperty ;
  rdfs:comment """The procedure or sensor system used in making the observation or estimate of property value.
  Reference to the NVS Method (S03 or S04 or S05) which is the object of interest.
  """ ;
  rdfs:domain puv:Parameter , dpnd:Observation ;
  rdfs:label "method" ;
  rdfs:range [
      a owl:Class ;
      owl:unionOf ( puv:Method puv:PrepMethod puv:AnalyticalMethod puv:DataProcessingMethod ) ;
    ] ;
  skos:note "puv:PrepMethod Terms => NVS S03 <https://vocab.nerc.ac.uk/collection/S03/>" ;
  skos:note "puv:AnalyticalMethod Terms => NVS S04 <https://vocab.nerc.ac.uk/collection/S04/>" ;
  skos:note "puv:DataProcessingMethod Terms => NVS 05 <https://vocab.nerc.ac.uk/collection/S05/>" ;
.
puv:objectOfInterest
  owl:equivalentProperty dpnd:relatedFeature ;
  owl:equivalentProperty dpnd:relatedSubstanceOrTaxon ;
  owl:equivalentProperty op:featureOfInterest ;
  owl:equivalentProperty op:objectOfInterest ;
  owl:equivalentProperty puv:biologicalObject ;
  owl:equivalentProperty puv:chemicalObject ;
  owl:equivalentProperty puv:physicalObject ;
  owl:equivalentProperty qudt:generalization ;
  rdf:type owl:ObjectProperty ;
  rdfs:comment "NVS Entity which is the object of interest for these observations. Can be a Biological entity (S25), Chemical Substance (S27) or Physical Phenomenon (S29)" ;
  rdfs:domain puv:Parameter , dpnd:Observation ;
  rdfs:label "object of interest" ;
  rdfs:range [
      a owl:class ;
      owl:unionOf ( puv:Entity puv:BiologicalEntity puv:ChemicalEntity puv:PhysicalEntity ) ;
  ] ;
  skos:note "puv:BiologicalEntity Terms => NVS S25 <https://vocab.nerc.ac.uk/collection/S25/>" ;
  skos:note "puv:ChemicalEntity Terms => NVS S27 <https://vocab.nerc.ac.uk/collection/S27/>" ;
  skos:note "puv:PhysicalEntity Terms => NVS S29 <https://vocab.nerc.ac.uk/collection/S29/>" ;
.
puv:property
  owl:equivalentProperty dpnd:relatedQuantityKind ;
  owl:equivalentProperty qudt:hasQuantityKind ;
  rdf:type owl:ObjectProperty ;
  rdfs:comment """Reference to the NVS S06 property or attribute that is being measured, which must be associated with either an object of interest or a matrix or both.""" ;
  rdfs:domain puv:Parameter , dpnd:Observation ;
  rdfs:label "property" ;
  rdfs:range puv:Property ;
  skos:note "puv:Property Terms => NVS S06 <https://vocab.nerc.ac.uk/collection/S06/>" ;
.
puv:statistic
  rdf:type owl:ObjectProperty ;
  rdfs:comment """Reference to the NVS S07 term that describes the statistical treatment of the observation.
  This property on a dpn:Observation resource, this overrides the equivalent property value inherited from dpn:Observation -> parameter.
  """ ;
  rdfs:domain puv:Parameter , dpnd:Observation ;
  rdfs:label "statistic" ;
  rdfs:range puv:ParameterStatistic ;
  skos:note "puv:ParameterStatistic Terms => NVS S07 <https://vocab.nerc.ac.uk/collection/S07/>" ;
.
puv:uom
  owl:equivalentProperty dpnd:relatedUnit ;
  owl:equivalentProperty qudt:unit ;
  rdf:type owl:ObjectProperty ;
  rdfs:comment """Reference to the NVS P06 term that specifies the scale or unit of measurement for the observation.
  If no suitable puv:Unit exists, then use qudt:unit (targetting a qudt:Unit resource) instead.
  """ ;
  rdfs:domain puv:Parameter , dpnd:Observation ;
  rdfs:label "uom" ;
  rdfs:range puv:UnitOfMeasurement ;
  skos:note "puv:Unit Terms => NVS P06 <https://vocab.nerc.ac.uk/collection/P06/>" ;
.
puv:parameter
  owl:equivalentProperty op:property ;
  owl:equivalentProperty sosa:observedProperty ;
  rdf:type owl:ObjectProperty ;
  rdfs:comment "The NVS P01 Parameter that is the equivalent to this Observation, and the source of any properties from the puv namespace which have not been overridden." ;
  rdfs:domain dpnd:Observation ;
  rdfs:label "parameter" ;
  rdfs:range puv:Parameter ;
  skos:note "puv:Parameter Terms => NVS P01 <https://vocab.nerc.ac.uk/collection/P01/>" ;
.
